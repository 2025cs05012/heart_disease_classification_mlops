# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.env

# Jupyter
.ipynb_checkpoints/

# Data artefacts
# Keep the raw UCI dataset and the cleaned CSV committed for one-shot
# reproducibility (rubric: "Cleaned dataset and download script/instructions").
# Only ignore the redundant zip archive — download.py can recreate it.
data/raw/heart+disease.zip

# MLflow tracking store (regenerated on every train; large)
mlruns/
mlartifacts/

# Models — committed: heart_pipeline.joblib + models/mlflow_model/
# (rubric Task 4: "Save the final model in a reusable format").
# Ignore stray pickles / experimental dumps elsewhere.
*.pkl
!models/mlflow_model/model.pkl
/models/*.pkl
!/models/heart_pipeline.joblib

# OS / IDE
.DS_Store
.idea/
.vscode/

# Reports — figures committed so reports/REPORT.md renders correctly on
# GitHub (architecture.png, ROC, confusion matrix, EDA plots).
# Build artefacts (HTML/PDF/DOCX) are committed too — they ARE the
# Task 9 deliverables.

# Coverage / pytest
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
pytest-report.xml
.ruff_cache/

